# Fork-only Dockerfile used by .github/workflows/release.yml (docker-ghcr-build-push).
# It builds the binary from source in a multi-stage build because this fork has
# no GoReleaser Pro. Upstream's init/docker/Dockerfile (used by .goreleaser.yaml
# dockers_v2) copies a prebuilt binary instead; keep that file untouched so
# future upstream merges stay conflict-free.
#
# --platform=$BUILDPLATFORM: run the Go toolchain natively on the runner and
# cross-compile via TARGETOS/TARGETARCH instead of emulating it under QEMU.
FROM --platform=$BUILDPLATFORM golang:1.27-alpine@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125 AS builder

WORKDIR /src
COPY main.go go.mod go.sum ./
RUN go mod download
# init/config's generator imports pkg/configdef, so pkg/ must be present
# before go generate writes examples/.
COPY examples examples
COPY pkg pkg
COPY init/config init/config
RUN go generate ./init/config

ARG TARGETOS
ARG TARGETARCH
ARG BUILD_DATE
ARG BRANCH
ARG VERSION
ARG ITERATION
ARG COMMIT

ENV GOFLAGS="-trimpath -mod=readonly -modcacherw"
ENV GOOS=${TARGETOS}
ENV GOARCH=${TARGETARCH}

RUN go build -o /tmp/unpackerr -tags osusergo,netgo \
    -ldflags "-w -s -X \"golift.io/version.Branch=${BRANCH} (${COMMIT})\" \
    -X \"golift.io/version.BuildDate=${BUILD_DATE}\" \
    -X \"golift.io/version.BuildUser=docker\" \
    -X \"golift.io/version.Revision=${ITERATION}\" \
    -X \"golift.io/version.Version=${VERSION}\""

FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

# Make sure we have an ssl cert chain and timezone data (plus curl/jq for scripting).
RUN apk add --no-cache ca-certificates openssl tzdata curl jq

ARG TARGETOS
ARG TARGETARCH
ARG BUILD_DATE
ARG COMMIT
ARG VERSION
ARG ITERATION
ARG LICENSE=MIT
ARG SOURCE_URL=https://github.com/Unpackerr/unpackerr
ARG DESC="Extracts downloads so Radarr, Sonarr, Lidarr or Readarr may import them."
ARG VENDOR="Go Lift <code@golift.io>"
ARG AUTHOR="David Newhall II <captain at golift dot io>"
# Build-time metadata as defined at https://github.com/opencontainers/image-spec/blob/master/annotations.md
LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="Unpackerr" \
      org.opencontainers.image.documentation="https://unpackerr.zip" \
      org.opencontainers.image.description="${DESC}" \
      org.opencontainers.image.url="${SOURCE_URL}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.vendor="${VENDOR}" \
      org.opencontainers.image.authors="${AUTHOR}" \
      org.opencontainers.image.architecture="${TARGETOS} ${TARGETARCH}" \
      org.opencontainers.image.licenses="${LICENSE}" \
      org.opencontainers.image.version="${VERSION}-${ITERATION}"

COPY --from=builder --chmod=755 /tmp/unpackerr /unpackerr

ENV TZ=UTC

ENTRYPOINT ["/unpackerr"]
